<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Playwright Java Authenticated Tests" parallel="none">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>
    <test name="Verified dashboard and application navigation">
        <groups>
            <run>
                <include name="authenticated"/>
            </run>
        </groups>
        <classes>
            <class name="tests.DashboardTest"/>
            <class name="tests.ApplicationNavigationTest"/>
        </classes>
    </test>
</suite>
